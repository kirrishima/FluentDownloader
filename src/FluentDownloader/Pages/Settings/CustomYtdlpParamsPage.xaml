<Page
    x:Class="FluentDownloader.Pages.Settings.CustomYtdlpParamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FluentDownloader.Converters"
    xmlns:local="using:FluentDownloader.Pages.Settings">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Page.Resources>
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Header="Key" Text="{x:Bind NewKey, Mode=TwoWay}" />

                <TextBox
                    Grid.Column="1"
                    Header="Value"
                    Text="{x:Bind NewValue, Mode=TwoWay}" />

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Click="Add_Click"
                    ToolTipService.ToolTip="Add">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Grid>
        </Border>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind Options}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:YtdlpOptionItem">
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">

                        <Grid>
                            <!--  View mode  -->
                            <Grid Visibility="{x:Bind NotIsEditing, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Key}"
                                        TextWrapping="NoWrap" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Value}"
                                        TextWrapping="NoWrap" />

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="Edit_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Edit">
                                            <SymbolIcon Symbol="Edit" />
                                        </Button>

                                        <Button
                                            Click="Delete_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Delete">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!--  Edit mode  -->
                            <Grid Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{x:Bind Key, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay}" />

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Click="SaveItem_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Save">
                                            <SymbolIcon Symbol="Save" />
                                        </Button>

                                        <Button
                                            Click="CancelItem_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Cancel">
                                            <SymbolIcon Symbol="Cancel" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>