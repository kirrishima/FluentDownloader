<Page
    x:Class="FluentDownloader.Pages.Settings.CustomYtdlpParamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentDownloader.Pages.Settings">

    <Grid Margin="20" RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ADD PANEL  -->
        <StackPanel Orientation="Horizontal" Spacing="8">

            <TextBox
                Width="200"
                PlaceholderText="Param"
                Text="{x:Bind NewKey, Mode=TwoWay}" />

            <TextBox
                Width="300"
                PlaceholderText="Value"
                Text="{x:Bind NewValue, Mode=TwoWay}" />

            <Button Click="Add_Click" Content="Add" />
        </StackPanel>

        <!--  LIST  -->
        <ListView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind Options}"
            SelectionMode="None">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:YtdlpOptionItem">

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{x:Bind Key, Mode=TwoWay}" />

                        <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay}" />

                        <Button
                            Grid.Column="2"
                            Click="Delete_Click"
                            Content="Delete"
                            Tag="{x:Bind}" />
                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>